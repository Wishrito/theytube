{% extends "models/layout.j2" %}
{% block title %}Résultats pour "{{ query }}"{% endblock %}

{% block content %}
<div class="min-h-[80vh] px-4 py-8">
    <h1 class="text-3xl font-bold text-indigo-600 mb-6 text-center">
        Résultats pour "{{ query }}"
    </h1>

    <ul id="results-list" class="grid gap-6 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
        {% for video in results %}
        <li class="bg-white shadow rounded-xl overflow-hidden hover:shadow-lg transition">
            <form method="post" class="h-full" action="{{ url_for('play', video_id=video['id']) }}">
                <button class="block" type="submit">
                    <img class="w-full h-48 object-cover" src="{{ video['thumbnails'][0] }}" alt="Miniature de la vidéo">
                    <div class="p-4">
                        <h3 class="video-title font-semibold text-gray-800 text-lg mb-1">{{ video['title'] }}</h3>
                        <p class="video-meta text-gray-500 text-sm">
                            {{ video['channel'] }} • {{ video['duration'] }}
                        </p>
                    </div>
                    <input type="hidden" name="query" value="{{ query }}">
                </button>
            </form>
        </li>
        {% endfor %}
        </ul>
<div class="mt-8 text-center">
    <a href="/" class="inline-block px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition">
        Retour
    </a>
</div>
</div>
{% endblock %}