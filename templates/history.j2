{% extends "models/layout.j2" %}
{% block title %}Historique de visionnage{% endblock %}

{% block content %}
<div class="min-h-[80vh] px-4 py-8">
    <div class="flex flex-col md:flex-row justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-indigo-600 mb-4 md:mb-0">Historique de visionnage</h1>

        <form action="/history/clear" method="post">
            <button type="submit" class="px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition">
                Effacer l'historique
            </button>
        </form>
    </div>

    {% if history %}
    <ul id="results-list" class="grid gap-6 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
        {% for video in history %}
        <li class="bg-white shadow rounded-xl overflow-hidden hover:shadow-lg transition">
            <a href="/play/{{ video['id'] }}" class="block">
                <img class="w-full h-48 object-cover" src="{{ video['thumbnail'] }}" alt="Miniature de la vidéo">
                <div class="p-4">
                    <h3 class="video-title font-semibold text-gray-800 text-lg mb-1">{{ video['title'] }}</h3>
                    <p class="video-meta text-gray-500 text-sm">
                        {{ video['channel'] }} •
                        {{ video['duration']['hours'] }}:{{ video['duration']['minutes'] }}:{{
                        video['duration']['seconds'] }}
                    </p>
                </div>
            </a>
        </li>
        {% endfor %}
    </ul>
    {% else %}
    <p class="text-gray-600 text-center mt-10">Aucune vidéo dans l'historique.</p>
    {% endif %}
</div>
{% endblock %}